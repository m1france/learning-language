{
  "name": "vivre-la-langue",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "dev:server": "npm --prefix server run dev",
    "build:server": "npm --prefix server run build",
    "test:security": "npm run build:server && node scripts/check-server-security.mjs",
    "test:coach": "node scripts/check-speaking-coach.cjs",
    "audit:code": "node scripts/audit-code.mjs",
    "test:sync": "node scripts/check-sync.mjs",
    "test:auth": "npm run build:server && node scripts/check-auth.mjs",
    "test:sharing": "node scripts/check-sharing.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.1"
  }
}
