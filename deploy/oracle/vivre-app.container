[Unit]
Description=Vivre la langue - application et comptes utilisateurs
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/vivre-la-langue:oracle
Pull=never
ContainerName=vivre-app
Network=vivre.network
NetworkAlias=app
EnvironmentFile=/etc/vivre-la-langue.env
Environment=NODE_OPTIONS=--max-old-space-size=128
Volume=/opt/vivre-la-langue/data:/app/data:Z
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
MemoryMax=320M

[Install]
WantedBy=multi-user.target
